# Backend API Configuration
VITE_API_BASE_URL=http://localhost:8080

# Application Configuration
VITE_APP_NAME=Datawise Frontend
VITE_APP_VERSION=1.0.0

# Public site URL — used for SEO canonical/OG URLs and absolute asset paths
VITE_SITE_URL=http://localhost:3000

# Optional: Google Analytics (gtag.js measurement ID)
# VITE_GTAG_ID=

# Optional: Sentry Configuration
# VITE_SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT=development

# Optional: Feature Flags
# VITE_ENABLE_DEVTOOLS=true

# Optional: SEO — set to "true" on staging/preview to prevent search engine indexing
# VITE_NOINDEX=true
